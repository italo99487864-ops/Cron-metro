<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:text="00:00.00"
        android:textColor="#F2F1EE"
        android:textSize="48sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Zerar: quadrado (parar e voltar a 00:00) -->
        <ImageButton
            android:id="@+id/btnReset"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn"
            android:contentDescription="Zerar"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_stop"
            android:tint="#FFFFFF" />

        <!-- Play / Pausa: o ícone troca conforme o estado -->
        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_accent"
            android:contentDescription="Iniciar"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            android:tint="#14161A" />

        <!-- Reiniciar: seta circular (zera e já começa a contar) -->
        <ImageButton
            android:id="@+id/btnRestart"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn"
            android:contentDescription="Reiniciar"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_restart"
            android:tint="#FFFFFF" />

        <!-- Fechar a janela flutuante -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn"
            android:contentDescription="Fechar"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:tint="#8B909A" />
    </LinearLayout>
</LinearLayout>
