<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="4"
        android:text="00:00.00"
        android:textColor="#F2F1EE"
        android:textSize="48sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- Zerar: quadrado -->
        <ImageButton
            android:id="@+id/btnReset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Zerar"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_stop" />

        <!-- Play / Pausa: o ícone troca conforme o estado -->
        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Iniciar"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play" />

        <!-- Reiniciar: seta circular -->
        <ImageButton
            android:id="@+id/btnRestart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Reiniciar"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_restart" />

        <!-- Aparência: abre o painel de cores e transparência -->
        <ImageButton
            android:id="@+id/btnPalette"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Cores e transparência"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_contrast" />

        <!-- Fechar a janela flutuante -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:contentDescription="Fechar"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Painel de aparência (começa escondido) -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblAlpha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transparência do fundo: 0%"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekAlpha"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="95" />

        <TextView
            android:id="@+id/lblFundo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Cor do fundo"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowFundo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/lblNumeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cor dos números e ícones"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowNumeros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/lblDestaque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cor de destaque (play e centésimos)"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowDestaque"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvRestaurar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:text="Restaurar padrão"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
