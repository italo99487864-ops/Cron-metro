<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14161A"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Cronômetro"
        android:textColor="#F2F1EE"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Abra a janela flutuante, arraste para onde quiser e use em cima de qualquer app."
        android:textColor="#8B909A"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="#FF6A4D"
        android:text="Abrir cronômetro flutuante"
        android:textColor="#14161A"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#1D2026"
        android:text="Fechar janela flutuante"
        android:textColor="#F2F1EE"
        android:textSize="16sp" />
</LinearLayout>
